FROM rust:1.94-bookworm AS builder
WORKDIR /src
COPY infra/docker/Cargo.torka.toml ./Cargo.toml
COPY Cargo.lock ./
COPY common ./common
COPY desktop ./desktop
RUN cargo build --release -p torchat-desktop

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 tor \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10002 --create-home torchat
COPY --from=builder /src/target/release/torchat-desktop /usr/local/bin/torchat-desktop
COPY infra/docker/torka.py /usr/local/bin/torka-client
COPY infra/docker/torka.py /usr/local/lib/torka_client.py
COPY infra/docker/torka-integration.py /usr/local/bin/torka-integration
COPY infra/docker/torka-supervisor.py /usr/local/bin/torka
RUN chmod 0755 /usr/local/bin/torka /usr/local/bin/torka-client /usr/local/bin/torka-integration \
    && mkdir -p /var/lib/torchat \
    && chown -R torchat:torchat /var/lib/torchat
USER torchat
ENV TORCHAT_NICKNAME=Torka
ENV PYTHONPATH=/usr/local/lib
VOLUME ["/var/lib/torchat"]
ENTRYPOINT ["python3", "/usr/local/bin/torka"]
