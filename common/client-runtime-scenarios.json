{
  "protocol": 1,
  "scenarios": [
    {
      "id": "01_bootstrap",
      "initialState": {
        "profile": {
          "installationId": "installation-alice",
          "nickname": "Alice",
          "publicKey": "alice-public-key",
          "fingerprint": "alice-fingerprint"
        }
      },
      "commands": [
        {"method": "bootstrapRuntime"},
        {"method": "bootstrapRuntime"}
      ],
      "expectedResponses": [
        {"ok": true, "result": true},
        {"ok": true, "result": false}
      ],
      "expectedEvents": [
        {"type": "runtime_ready", "protocol": 1},
        {
          "type": "profile_ready",
          "profile": {
            "installationId": "installation-alice",
            "nickname": "Alice",
            "publicKey": "alice-public-key",
            "fingerprint": "alice-fingerprint"
          }
        }
      ]
    },
    {
      "id": "02_status_dedup",
      "commands": [
        {
          "method": "reportTorStatus",
          "params": {
            "status": {
              "phase": "connected",
              "label": "connected",
              "detail": "",
              "progress": 100,
              "latencyMs": 10,
              "retryAttempt": 0
            }
          }
        },
        {
          "method": "reportTorStatus",
          "params": {
            "status": {
              "phase": "connected",
              "label": "connected",
              "detail": "",
              "progress": 100,
              "latencyMs": 10,
              "retryAttempt": 0
            }
          }
        },
        {
          "method": "reportTorStatus",
          "params": {
            "status": {
              "phase": "reconnecting",
              "label": "reconnecting",
              "detail": "",
              "retryAttempt": 1
            }
          }
        }
      ],
      "expectedResponses": [
        {"ok": true, "result": true},
        {"ok": true, "result": true},
        {"ok": true, "result": true}
      ],
      "expectedEvents": [
        {"type": "tor_status", "phase": "connected", "label": "connected", "progress": 100, "latencyMs": 10, "retryAttempt": 0},
        {"type": "tor_status", "phase": "reconnecting", "label": "reconnecting", "retryAttempt": 1}
      ]
    },
    {
      "id": "03_message_send_success",
      "initialState": {
        "contacts": [
          {
            "installationId": "installation-bob",
            "nickname": "Bob",
            "publicKey": "bob-public-key",
            "fingerprint": "bob-fingerprint",
            "verification": "VERIFIED"
          }
        ],
        "conversations": [
          {
            "id": "installation-bob",
            "contactInstallationId": "installation-bob",
            "status": "ACTIVE",
            "lastMessagePreview": "",
            "lastMessageAt": 0,
            "unreadCount": 0
          }
        ]
      },
      "commands": [
        {
          "method": "sendMessage",
          "params": {"id": "installation-bob", "text": " hello "}
        },
        {
          "method": "applyMessageTransportOutcome",
          "params": {"messageId": "$response[0].result.messageId", "outcome": "FORWARDED"}
        },
        {
          "method": "applyMessageTransportOutcome",
          "params": {"messageId": "$response[0].result.messageId", "outcome": "DELIVERED"}
        }
      ],
      "expectedResponses": [
        {
          "ok": true,
          "result": {
            "conversationId": "installation-bob",
            "recipientInstallationId": "installation-bob",
            "body": "hello"
          }
        },
        {"ok": true, "result": {"state": "SENT"}},
        {"ok": true, "result": {"state": "DELIVERED"}}
      ],
      "expectedEvents": [
        {"type": "message_state_changed", "state": "QUEUED"},
        {"type": "changed", "kind": "conversations"},
        {"type": "message_state_changed", "state": "SENDING"},
        {"type": "message_state_changed", "state": "SENT"},
        {"type": "message_state_changed", "state": "DELIVERED"}
      ],
      "expectedFinalState": {
        "messages": [
          {"conversationId": "installation-bob", "body": "hello", "state": "DELIVERED"}
        ]
      }
    },
    {
      "id": "04_message_offline_retry",
      "initialState": {
        "contacts": [
          {
            "installationId": "installation-bob",
            "nickname": "Bob",
            "publicKey": "bob-public-key",
            "fingerprint": "bob-fingerprint",
            "verification": "VERIFIED"
          }
        ],
        "conversations": [
          {
            "id": "installation-bob",
            "contactInstallationId": "installation-bob",
            "status": "ACTIVE",
            "lastMessagePreview": "hello",
            "lastMessageAt": 42,
            "unreadCount": 0
          }
        ],
        "messages": [
          {
            "id": "00000000-0000-0000-0000-000000000001",
            "conversationId": "installation-bob",
            "outgoing": true,
            "body": "hello",
            "state": "SENDING",
            "createdAt": 42
          }
        ]
      },
      "commands": [
        {
          "method": "applyMessageTransportOutcome",
          "params": {"messageId": "00000000-0000-0000-0000-000000000001", "outcome": "RETRYABLE_FAILURE"}
        },
        {"method": "preparePendingSendEffects"}
      ],
      "expectedResponses": [
        {"ok": true, "result": {"state": "QUEUED"}},
        {
          "ok": true,
          "result": [
            {
              "messageId": "00000000-0000-0000-0000-000000000001",
              "conversationId": "installation-bob",
              "recipientInstallationId": "installation-bob",
              "body": "hello"
            }
          ]
        }
      ],
      "expectedEvents": [
        {"type": "message_state_changed", "messageId": "00000000-0000-0000-0000-000000000001", "state": "QUEUED"},
        {"type": "message_state_changed", "messageId": "00000000-0000-0000-0000-000000000001", "state": "SENDING"}
      ]
    },
