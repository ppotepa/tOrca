        {"type": "message_state_changed", "messageId": "00000000-0000-0000-0000-000000000002", "state": "DELIVERED"},
        {"type": "conversation_read_changed", "conversationId": "installation-bob", "unreadCount": 0},
        {"type": "changed", "kind": "conversations"}
      ],
      "expectedFinalState": {
        "conversations": [
          {"id": "installation-bob", "unreadCount": 0, "lastMessagePreview": "hi"}
        ]
      }
