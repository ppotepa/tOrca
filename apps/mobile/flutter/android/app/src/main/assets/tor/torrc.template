# Shared TorChat Android client configuration.
# This file is public and contains no identity, onion-service or bridge keys.
ClientOnly 1
SocksPort 127.0.0.1:<SOCKS_PORT>
DataDirectory <DATA_DIRECTORY>
# Preserve the private Tor cache in the app data directory. This makes warm
# restarts substantially faster; Android application storage remains private.
Log notice stdout
