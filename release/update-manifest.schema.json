{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torca.invalid/schema/update-manifest-v1.json",
  "title": "Torca signed update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithm", "keyId", "payload", "signature"],
  "properties": {
    "schema": { "const": 1 },
    "algorithm": { "const": "ed25519" },
    "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payload": { "type": "string", "contentEncoding": "base64" },
    "signature": { "type": "string", "contentEncoding": "base64" }
  }
}
